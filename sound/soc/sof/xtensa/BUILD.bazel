load(
    "//build/kernel/kleaf:kernel.bzl",
    "ddk_module",
)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

_AUDIO_DEFCONFIG = "//private/desktop-google:intel_audio_ddk.defconfig"

ddk_module(
    name = "snd-sof-xtensa-dsp",
    srcs = ["core.c"],
    out = "snd-sof-xtensa-dsp.ko",
    copts = [
        "-Iprivate/desktop-google/sound/soc/sof",
    ],
    deps = [
        "//private/desktop-google/sound/soc/sof:sof_headers",
    ],
    kconfig = "Kconfig",
    defconfig = _AUDIO_DEFCONFIG,
    kernel_build = "//private/devices/google/common:kernel_build",
)
